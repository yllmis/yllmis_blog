# 管理员后台登录密码（必填，未配置时写接口默认拒绝）
ADMIN_PASSWORD=change-me-to-a-strong-password

# 会话 Cookie 签名密钥（建议配置随机长字符串；不填则默认复用 ADMIN_PASSWORD）
AUTH_SECRET=change-me-to-a-random-secret

# ===== 以下三项仅在部署到 Vercel 需要「线上在线编辑」时配置 =====
# 本地开发留空即可，默认直接读写本机 content/ 目录下的 .md 文件
# GITHUB_TOKEN=github_pat_xxx
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=your-blog-repo
# GITHUB_BRANCH=main

# ===== 语雀开放花园自动同步配置（本地同步填这里，线上同步填到 GitHub Actions Secrets） =====
# YUQUE_TOKEN=your-yuque-openapi-token
# YUQUE_LOGIN=yllmis
# 可选：只同步指定公开知识库（逗号分隔 slug 或名称；留空则同步全部公开知识库）
# YUQUE_REPOS=uw8ppk
